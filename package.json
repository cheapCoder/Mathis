{
	"name": "mathis",
	"publisher": "happyHacking",
	"displayName": "Mathis",
	"description": "辅助国际化的 vscode 插件：hover 显示多语言值，定义与应用位置互跳",
	"version": "0.6.0",
	"repository": "https://github.com/cheapCoder/Mathis",
	"icon": "img/logo.png",
	"main": "./out/src/extension.js",
	"engines": {
		"vscode": "^1.65.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"workspaceContains:**/locale/**/*.{js,ts,jsx,tsx,json}"
	],
	"contributes": {
		"commands": [
			{
				"command": "mathis.genReport",
				"title": "generate the locale using report"
			},
			{
				"command": "mathis.showLog",
				"title": "show Mathis log"
			}
		],
		"languages": [
			{
				"id": "svelte",
				"aliases": [
					"Svelte",
					"svelte"
				],
				"extensions": [
					".svelte"
				]
			}
		],
		"keybindings": [
			{
				"key": "cmd+shift+v",
				"command": "mathis.searchFromClipboard"
			}
		],
		"configuration": [
			{
				"title": "Mathis",
				"properties": {
					"mathis.define": {
						"order": 4,
						"markdownDescription": "定义文件包含:[(使用vscode glob)](https://code.visualstudio.com/api/references/vscode-api#GlobPattern)",
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"include": {
									"type": "string",
									"markdownDescription": "参考findFiles Api[参考](https://code.visualstudio.com/api/references/vscode-api#workspace)"
								},
								"exclude": {
									"type": "string",
									"markdownDescription": "参考findFiles Api[参考](https://code.visualstudio.com/api/references/vscode-api#workspace)"
								}
							}
						},
						"default": [
							{
								"include": "{components,src}/**/locale/*.{ts,tsx,jsx,js,json}",
								"exclude": "**/{node_modules,test,__tests__}/**"
							},
							{
								"include": "node_modules/shoplazza-sdk/es/shoplazza-app/locale/*",
								"exclude": ""
							}
						]
					},
					"mathis.apply": {
						"order": 6,
						"markdownDescription": "findFile使用的参数[参考glob](https://code.visualstudio.com/api/references/vscode-api#GlobPattern)",
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"include": {
									"type": "string",
									"markdownDescription": "参考findFiles Api[参考](https://code.visualstudio.com/api/references/vscode-api#workspace)"
								},
								"exclude": {
									"type": "string",
									"markdownDescription": "参考findFiles Api[参考](https://code.visualstudio.com/api/references/vscode-api#workspace)"
								}
							}
						},
						"default": [
							{
								"include": "{components,src}/**/*.{ts,js,tsx,jsx,svelte,vue}",
								"exclude": "**/{node_modules,test,__tests__}/**"
							}
						]
					},
					"mathis.i18nLib": {
						"order": 8,
						"description": "i18n 库。auto 按工作区根目录 package.json 的依赖识别；根目录不是应用工程（如 monorepo、示例子目录）时手动指定。修改后需重载窗口",
						"type": "string",
						"default": "auto",
						"enum": [
							"auto",
							"react-intl",
							"svelte-i18n",
							"next-intl"
						]
					},
					"mathis.detectApplyWay": {
						"order": 9,
						"description": "检测应用节点的方式\nreg:正则匹配(会有缺失)); split:分词在def中查找(会有多余)",
						"type": "string",
						"default": "split",
						"enum": [
							"reg",
							"split"
						]
					},
					"mathis.defSelect": {
						"order": 10,
						"description": "跳转定义文件时选择字段的哪些部分",
						"type": "string",
						"default": "value",
						"enum": [
							"key",
							"value",
							"key and value"
						]
					},
					"mathis.useCompletion": {
						"order": 11,
						"description": "是否开启自动填充功能",
						"type": "boolean",
						"default": false
					},
					"mathis.pathSlice.enabled": {
						"order": 11,
						"type": "boolean",
						"default": true,
						"description": "显示路径时去除src之前的部分"
					},
					"mathis.delayTime": {
						"order": 12,
						"type": "number",
						"default": 1500,
						"description": "文件修改后更新节点的延时时间"
					},
					"mathis.remoteLocaleENV": {
						"order": 13,
						"description": "远程请求多语言的环境",
						"type": "string",
						"default": "production",
						"enum": [
							"develop",
							"staging",
							"production"
						]
					}
				}
			}
		]
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src test --ext ts",
		"test": "npm run compile && npm run lint && mocha \"out/src/**/*.test.js\"",
		"test:e2e": "npm run compile && node ./out/test/runTest.js",
		"test:visual": "npm run compile && node ./out/test/visual.js",
		"vscode:prepublish": "npm run esbuild-base --minify",
		"esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/src/extension.js --external:vscode --external:sql.js --format=cjs --platform=node --minify",
		"esbuild": "npm run esbuild-base -- --sourcemap",
		"esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
		"test-compile": "tsc -p ./"
	},
	"devDependencies": {
		"@types/acorn": "^4.0.6",
		"@types/glob": "^7.2.0",
		"@types/mocha": "^9.1.0",
		"@types/node": "^14.18.12",
		"@types/sql.js": "^1.4.9",
		"@types/vscode": "^1.65.0",
		"@typescript-eslint/eslint-plugin": "^5.15.0",
		"@typescript-eslint/parser": "^5.15.0",
		"@vscode/test-electron": "^3.1.0",
		"esbuild": "^0.14.28",
		"eslint": "^8.11.0",
		"mocha": "^9.2.2",
		"playwright-core": "^1.63.0",
		"typescript": "^4.6.2"
	},
	"dependencies": {
		"@humanwhocodes/momoa": "^2.0.3",
		"acorn": "^8.7.0",
		"sql.js": "^1.13.0"
	}
}
